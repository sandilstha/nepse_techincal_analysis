{% load static %}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NEPSE Swing Trading Strategy — SOP</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{% static 'core_analysis/css/insights.css' %}?v={{ asset_version }}">
  <style>
    html, body { margin: 0; min-height: 100%; }
    .sop-main { max-width: 980px; margin: 0 auto; padding: 18px 16px 56px; }
    .sop-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 12px; }
    .sop-head h1 { margin: 0 0 4px; font-size: 24px; font-weight: 800; color: var(--ink-1); }
    .sop-head p { margin: 0; max-width: 70ch; font-size: 13.5px; line-height: 1.55; color: var(--ink-2); opacity: .82; }
    .sop-back {
      display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
      padding: 7px 11px; border: 1px solid var(--line); border-radius: 8px;
      color: inherit; text-decoration: none; font-size: 13px; background: var(--surface);
    }
    .sop-back:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }
    .sop-meta {
      display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0 0 18px;
      padding: 10px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface);
      font-size: 12.5px; color: var(--ink-2);
    }
    .sop-meta b { color: var(--ink-1); }
    .sop-grid { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 18px; align-items: start; }
    .sop-toc {
      position: sticky; top: 16px; border: 1px solid var(--line); border-radius: 8px;
      padding: 13px 14px; background: var(--surface); font-size: 13px;
    }
    .sop-toc b { display: block; margin-bottom: 7px; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; opacity: .65; }
    .sop-toc a { display: block; padding: 4px 0; color: inherit; text-decoration: none; opacity: .82; }
    .sop-toc a:hover { opacity: 1; text-decoration: underline; }
    .sop-doc { min-width: 0; }
    .sop-sec {
      border: 1px solid var(--line); border-radius: 8px; padding: 16px 18px;
      margin-bottom: 14px; background: var(--surface); scroll-margin-top: 16px;
    }
    .sop-sec:target { outline: 2px solid var(--accent); outline-offset: 3px; }
    .sop-sec h2 { margin: 0 0 7px; font-size: 17px; font-weight: 800; color: var(--ink-1); }
    .sop-sec h3 { margin: 14px 0 5px; font-size: 13.5px; font-weight: 800; color: var(--ink-1); }
    .sop-sec p, .sop-sec li { color: var(--ink-2); font-size: 13.5px; line-height: 1.55; }
    .sop-sec p { margin: 6px 0; }
    .sop-sec ul { margin: 8px 0 0; padding-left: 20px; }
    .sop-sec li { margin: 3px 0; }
    .sop-table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 12.5px; }
    .sop-table th, .sop-table td { padding: 7px 9px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; color: var(--ink-2); }
    .sop-table th { color: var(--ink-1); font-size: 10.5px; text-transform: uppercase; letter-spacing: .06em; opacity: .72; }
    .sop-table code { color: var(--ink-1); }
    .sop-note { margin-top: 10px; padding: 8px 11px; border-left: 3px solid var(--accent); background: var(--surface-2); color: var(--ink-2); font-size: 12.5px; line-height: 1.55; }
    .sop-trigger { margin-top: 8px; padding: 8px 11px; border-left: 3px solid #eab308; background: var(--surface-2); color: var(--ink-1); font-size: 12.5px; font-weight: 600; }
    .sop-pill { display: inline-block; padding: 1px 7px; border-radius: 999px; font-size: 11px; font-weight: 700; }
    .sop-pill.s1 { background: rgba(148,163,184,.16); color: #94a3b8; }
    .sop-pill.s2 { background: rgba(34,197,94,.16); color: #22c55e; }
    .sop-pill.s3 { background: rgba(234,179,8,.18); color: #eab308; }
    .sop-pill.s4 { background: rgba(239,68,68,.16); color: #ef4444; }
    .sop-check li { list-style: none; margin-left: -20px; }
    .sop-check li::before { content: "\2610"; margin-right: 8px; color: var(--ink-3, #94a3b8); }
    .sop-report { white-space: pre-wrap; font-family: ui-monospace, "Cascadia Code", Menlo, Consolas, monospace;
      font-size: 12.5px; line-height: 1.7; color: var(--ink-2); background: var(--surface-2);
      border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; margin-top: 8px; overflow-x: auto; }
    @media (max-width: 820px) {
      .sop-head { flex-direction: column; }
      .sop-grid { grid-template-columns: 1fr; }
      .sop-toc { position: static; }
    }
  </style>
</head>