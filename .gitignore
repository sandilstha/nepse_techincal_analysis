.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, wishes may vary.
#.python-version

# pipenv
#   According to pypa/pipenv#1198, it is recommended to include Pipfile.lock in git.
#   However, on execution, pipenv creates a virtualenv in a hidden folder, which
#   should not be committed:
.venv/
venv/
ENV/
env/

# Poetry
#   Poetry creates local virtualenvs under certain configurations
.poetry/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# OS templates
.DS_Store
Thumbs.db

# Environment variables & Secrets
.env
.secrets
venv
venv/
graphify-out/

# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------

# Headless-browser profile written by the breadth/screenshot tooling. This is a
# full Chromium profile (cache, cookies, history, service-worker databases) and
# has no business in the repo.
.tmp-breadth-profile/

# Scratch + temp files
*.tmp
*.bak
*.orig
*.rej
_sop_head.tmp

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Node (only if a front-end toolchain is ever added)
node_modules/

# Claude Code: the committed CLAUDE.md and skills stay tracked; only the
# machine-local settings and scratch state are ignored.
.claude/settings.local.json
.claude/.session*

# Database dumps / backups
*.sql
*.sql.gz
*.dump
*.bak.sql

# Local env variants beyond the plain .env already ignored above
.env.*
!.env.example
